<UserControl x:Class="AFMS.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="{Binding OutstandingSummary}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" VerticalAlignment="Top" Margin="0,6,0,0"
                        Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,10,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Summary tiles -->
            <UniformGrid Grid.Row="2" Rows="2" Columns="4" Margin="0,16,0,0">
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding TotalOnHand, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="PIECES ON HAND" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding OutstandingQuantity, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="STILL OUT WITH PEOPLE" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding PeopleHoldingItems, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="PEOPLE HOLDING ITEMS" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="{Binding LowStockCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="ITEMS RUNNING LOW" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding StockInThisMonth, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}">
                            <Run Text="STOCK-IN ENTRIES," /><Run Text=" " />
                            <Run Text="{Binding MonthLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding ReleasesThisMonth, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}">
                            <Run Text="RELEASES," /><Run Text=" " />
                            <Run Text="{Binding MonthLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding ActiveItems, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="ITEMS TRACKED" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}"
                                   Text="{Binding ActiveRecipients, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="PEOPLE ON FILE" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Running low" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Margin="0,4,0,10" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Items at or below the level you set." />

                        <TextBlock Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                                   Text="Nothing is running low."
                                   Visibility="{Binding HasLowStock, Converter={StaticResource BooleanToCollapsedConverter}}" />

                        <ItemsControl ItemsSource="{Binding LowStockItems}"
                                      Visibility="{Binding HasLowStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding Code}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#FFF1E4" CornerRadius="11"
                                                Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock FontWeight="Bold" FontSize="11"
                                                       Foreground="{StaticResource WarningBrush}">
                                                <Run Text="{Binding OnHand, Mode=OneWay, StringFormat={}{0:N0}}" />
                                                <Run Text="{Binding Unit, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Latest activity" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Margin="0,4,0,10" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="The last dozen entries, newest first." />
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentActivity}" MinHeight="200"
                                  AutomationProperties.Name="Latest activity">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Width="100"
                                                    Binding="{Binding Date, StringFormat=MMM d\, yyyy}" />
                                <DataGridTextColumn Header="" Binding="{Binding DirectionLabel}" Width="46" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}"
                                                    Width="125" />
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                                <DataGridTextColumn Header="Qty" Width="60"
                                                    Binding="{Binding Quantity, StringFormat={}{0:N0}}"
                                                    ElementStyle="{StaticResource NumericCellStyle}" />
                                <DataGridTextColumn Header="Who" Binding="{Binding PartyName}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
