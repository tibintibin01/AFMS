<UserControl x:Class="AFMS.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="A live overview of accountable forms, collector balances, and work requiring attention." Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
                <Button Grid.Column="1" Content="Refresh dashboard" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,22,0,0">
                <Border Style="{StaticResource RaisedCardStyle}" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="10" Background="#E8F4EE" VerticalAlignment="Top"><TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="AVAILABLE RECEIPTS" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding Summary.AvailableReceipts, StringFormat=N0}" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Ready for issuance" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource RaisedCardStyle}" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="10" Background="#FFF3DA" VerticalAlignment="Top"><TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WarningBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="OUTSTANDING" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding Summary.OutstandingReceipts, StringFormat=N0}" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Held by collectors" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource RaisedCardStyle}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource NavyLightBrush}" VerticalAlignment="Top"><TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource NavyBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="ACTIVE COLLECTORS" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding Summary.ActiveCollectors, StringFormat=N0}" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Currently authorized" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></StackPanel></Grid></Border>
            </UniformGrid>

            <UniformGrid Grid.Row="2" Columns="3">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12"><StackPanel><TextBlock Text="DRAFT TRANSACTIONS" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding Summary.DraftTransactions}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Not yet submitted" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12"><StackPanel><TextBlock Text="PENDING APPROVAL" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding Summary.PendingApprovals}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Supervisor attention required" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="UNRESOLVED EXCEPTIONS" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding Summary.UnresolvedExceptions}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Awaiting resolution" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="3" Background="#FFF9EA" BorderBrush="#E8D49C" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,6,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#F8E8BC" VerticalAlignment="Top"><TextBlock Text="&#xE8E9;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Backup and inventory protection" FontWeight="SemiBold"/><TextBlock Text="{Binding Backup.Options.LocationWarning}" TextWrapping="Wrap" Foreground="#6C582B" Margin="0,3,0,0"/><WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding Backup.LastSuccessfulBackup, StringFormat=Last validated backup: {0:g}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,22,0"/><TextBlock Text="{Binding Summary.LastStockMovement, StringFormat=Last inventory movement: {0:g}}" Foreground="{StaticResource MutedTextBrush}"/></WrapPanel></StackPanel></Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
