<Window x:Class="AFMS.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to AFMS"
        Width="820" Height="520" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource NavyBrush}">
            <Grid Margin="48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="74" Height="74" CornerRadius="37" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="AF" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Row="1" Margin="0,40,0,0">
                    <TextBlock Text="AFMS" Foreground="White" FontSize="33" FontWeight="Bold" />
                    <TextBlock Text="Accountable Forms&#x0a;Management System" Foreground="#DDE7F0" FontSize="19" LineHeight="28" Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Municipal Treasury Office • Offline" Foreground="#AFC0CF" FontSize="12" />
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="White">
            <StackPanel Margin="60" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock Text="Welcome back" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Sign in with your authorized AFMS account." Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,7,0,28" />
                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,17,0,6" />
                <PasswordBox PasswordChanged="HandlePasswordChanged" MaxLength="128" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" MinHeight="36" Margin="0,14,0,6" />
                <Button Content="Sign in" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
