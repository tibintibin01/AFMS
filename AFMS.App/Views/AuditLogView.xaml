<UserControl x:Class="AFMS.App.Views.AuditLogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Audit Log" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Append-only, integrity-chained security and business activity." Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/><ColumnDefinition Width="170"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText}" ToolTip="Search user, description, entity, reference, or computer"/><DatePicker Grid.Column="1" Margin="6,0" SelectedDate="{Binding FromDate}" ToolTip="From date"/><DatePicker Grid.Column="2" Margin="0,0,6,0" SelectedDate="{Binding ToDate}" ToolTip="To date"/><ComboBox Grid.Column="3" ItemsSource="{Binding ActivityTypes}" SelectedItem="{Binding ActivityType}" ToolTip="Activity type"/><Button Grid.Column="4" Content="Search" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/></Grid>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding OccurredAt, StringFormat=g}" Width="145"/><DataGridTextColumn Header="User" Binding="{Binding Username}" Width="110"/><DataGridTextColumn Header="Computer" Binding="{Binding MachineName}" Width="120"/><DataGridTextColumn Header="Action" Binding="{Binding ActivityType}" Width="130"/><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="135"/><DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="135"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8"><TextBlock Text="{Binding TotalCount, Mode=OneWay, StringFormat={}{0:N0} entries}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock VerticalAlignment="Center" Margin="10,0"><Run Text="Page "/><Run Text="{Binding Page, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding TotalPages, Mode=OneWay}"/></TextBlock><Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Grid>
    <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Original values" FontWeight="SemiBold"/><TextBox Text="{Binding SelectedItem.OldValues}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="95"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="New values" FontWeight="SemiBold"/><TextBox Text="{Binding SelectedItem.NewValues}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="95"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Reason and integrity" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedItem.Reason}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedItem.IntegrityHash, StringFormat=Hash: {0}}" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"/></StackPanel></Grid></Border>
  </Grid>
</UserControl>
