<UserControl x:Class="AFMS.App.Views.StockMovementHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Stock Movement History" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Central chronological record of every accountable-form stock movement." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reference, form, source, or destination" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding FormTypes}" SelectedItem="{Binding SelectedFormType}" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding SelectedMovementType}" Margin="0,0,8,0"/>
            <TextBox Grid.Column="3" Text="{Binding SerialNumberText}" ToolTip="Receipt serial number" Margin="0,0,8,0"/>
            <DatePicker Grid.Column="4" SelectedDate="{Binding FromDate}" ToolTip="From date" Margin="0,0,8,0"/>
            <DatePicker Grid.Column="5" SelectedDate="{Binding ToDate}" ToolTip="To date" Margin="0,0,8,0"/>
            <Button Grid.Column="6" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"/>
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date / time" Binding="{Binding OccurredAt, StringFormat={}{0:MMM dd, yyyy HH:mm}}" Width="145"/>
                <DataGridTextColumn Header="Movement" Binding="{Binding MovementType}" Width="90"/>
                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="145"/>
                <DataGridTextColumn Header="Form type" Binding="{Binding FormType}" Width="*" MinWidth="170"/>
                <DataGridTextColumn Header="Beginning" Binding="{Binding BeginningSerial}" Width="90"/>
                <DataGridTextColumn Header="Ending" Binding="{Binding EndingSerial}" Width="90"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="130"/>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding Message}" Margin="0,10,0,0" Style="{StaticResource NotificationTextStyle}"/>
    </Grid>
</UserControl>
