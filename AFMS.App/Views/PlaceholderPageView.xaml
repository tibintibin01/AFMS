<UserControl x:Class="AFMS.App.Views.PlaceholderPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="29" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="15" Margin="0,6,0,0" />
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,30,0,24">
                <Border Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,12,0" MinHeight="112">
                    <StackPanel>
                        <TextBlock Text="FOUNDATION" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Ready" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Core architecture configured" Foreground="#257247" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="6,0" MinHeight="112">
                    <StackPanel>
                        <TextBlock Text="DATABASE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="SQLite" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Local and offline" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="12,0,0,0" MinHeight="112">
                    <StackPanel>
                        <TextBlock Text="MODULE STATUS" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Planned" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Awaiting next phase" Foreground="#9A6700" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28" MinHeight="180">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                    <Border Width="46" Height="4" Background="{StaticResource GoldBrush}" CornerRadius="2" HorizontalAlignment="Center" />
                    <TextBlock Text="Foundation phase" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,8" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
