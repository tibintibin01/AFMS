<Window x:Class="AFMS.App.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AFMS.App.Views"
        Title="Sign in to AFMS Inventory"
        Width="860" Height="540" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <views:BrandPanel />

        <Border Grid.Column="1" Background="White">
            <StackPanel Margin="56" VerticalAlignment="Center" MaxWidth="370">
                <TextBlock Text="Welcome back" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Sign in to open your inventory records."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,7,0,28" />

                <Label Content="_Username" Target="{Binding ElementName=UsernameBox}" Padding="0,0,0,6"
                       FontWeight="SemiBold" />
                <TextBox x:Name="UsernameBox" MaxLength="100"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Username" />

                <Label Content="_Password" Target="{Binding ElementName=PasswordBox}" Padding="0,17,0,6"
                       FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordBox" MaxLength="128" PasswordChanged="OnPasswordChanged"
                             AutomationProperties.Name="Password" />

                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" MinHeight="38" Margin="0,14,0,6" />

                <Button Content="Sign in" Command="{Binding SignInCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
