<UserControl x:Class="AFMS.App.Views.IssuanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Accountable Forms Issuance" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Prepare, approve, and issue available booklets to authorized collectors." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search reference or collector" Margin="0,0,8,0"/><Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Grid.Column="2" Content="New issuance" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="570"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding Issuances}" SelectedItem="{Binding SelectedIssuance}"><DataGrid.Columns>
                    <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="145"/><DataGridTextColumn Header="Date" Binding="{Binding DateIssued, StringFormat={}{0:MMM dd, yyyy}}" Width="100"/><DataGridTextColumn Header="Collector" Binding="{Binding Collector}" Width="*"/><DataGridTextColumn Header="Barangay / area" Binding="{Binding BarangayOrArea}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                </DataGrid.Columns></DataGrid>
                <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="View" Command="{Binding ViewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Edit draft" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Submit" Command="{Binding SubmitCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Approve" Command="{Binding ApproveCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Reject" Command="{Binding RejectCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Finalize" Command="{Binding FinalizeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Reverse" Command="{Binding ReverseCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
            </Grid>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Issuance details" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding ReferenceNumber}" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsReadOnly, Converter={StaticResource BooleanNegationConverter}}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Date issued *" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding DateIssued}"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Collector *" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Collectors}" SelectedItem="{Binding SelectedCollector}"/></StackPanel></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Assigned barangay" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Barangays}" SelectedItem="{Binding SelectedBarangay}"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Other collection area" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding CollectionArea}"/></StackPanel></Grid>
                        <TextBlock Text="Purpose *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Purpose}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Released by *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding ReleasedBy}"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Received by *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding ReceivedBy}"/></StackPanel></Grid>
                        <TextBlock Text="Inventory selection" FontWeight="SemiBold" Margin="0,14,0,4"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding FormTypes}" SelectedItem="{Binding FilterFormType}" Margin="0,0,5,0"/><TextBox Grid.Column="1" Text="{Binding SeriesYearFilter}" ToolTip="Series year" Margin="0,0,5,0"/><TextBox Grid.Column="2" Text="{Binding StorageFilter}" ToolTip="Storage" Margin="0,0,5,0"/><TextBox Grid.Column="3" Text="{Binding BeginningFilter}" ToolTip="Beginning serial" Margin="0,0,5,0"/><TextBox Grid.Column="4" Text="{Binding EndingFilter}" ToolTip="Ending serial"/></Grid>
                        <Button Content="Refresh issuable inventory" Command="{Binding LoadAvailableCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,6" Padding="10,5"/>
                        <DataGrid ItemsSource="{Binding AvailableBooklets}" IsReadOnly="False" Height="210" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected}" Width="70"/><DataGridTextColumn Header="Form type" Binding="{Binding FormType}" IsReadOnly="True" Width="140"/><DataGridTextColumn Header="Year" Binding="{Binding SeriesYear}" IsReadOnly="True" Width="70"/><DataGridTextColumn Header="Beginning" Binding="{Binding BeginningSerial}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="Ending" Binding="{Binding EndingSerial}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" IsReadOnly="True" Width="75"/></DataGrid.Columns></DataGrid>
                        <TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="48"/>
                        <TextBlock Text="Decision / reversal reason" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding DecisionReason}"/>
                    </StackPanel></ScrollViewer>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Close" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Save draft" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" Style="{StaticResource NotificationTextStyle}"/><Button Grid.Column="1" Content="Print preview" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Grid.Column="2" Content="Export PDF" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
    </Grid>
</UserControl>
