<Window x:Class="AFMS.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AFMS.App.Views"
        Title="Set up AFMS Inventory"
        Width="880" Height="620" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <views:BrandPanel />

        <ScrollViewer Grid.Column="1" Background="White" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="46,40" MaxWidth="400">
                <TextBlock Text="Create your account" FontSize="27" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14" Margin="0,8,0,26"
                           Text="This is a one-time step. There is no default password, and nothing is sent anywhere." />

                <Label Content="Your _full name" Target="{Binding ElementName=NameBox}"
                       Padding="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" MaxLength="200"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Your full name" />

                <Label Content="_Username to sign in with" Target="{Binding ElementName=UsernameBox}"
                       Padding="0,16,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="UsernameBox" MaxLength="100"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Username" />

                <TextBlock Text="Password" Padding="0,16,0,6" FontWeight="SemiBold" />
                <views:RevealPasswordBox x:Name="PasswordBox" FieldName="Password"
                                        Password="{Binding Password, Mode=TwoWay}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" Margin="0,6,0,0"
                           Text="At least 12 characters, with an uppercase letter, a lowercase letter, a number, and a symbol. Use the eye to check what you typed." />

                <TextBlock Text="Type the password again" Padding="0,16,0,6" FontWeight="SemiBold" />
                <views:RevealPasswordBox x:Name="ConfirmBox" FieldName="Confirm password"
                                        Password="{Binding ConfirmPassword, Mode=TwoWay}" />

                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" MinHeight="34" Margin="0,16,0,10" />

                <Button Content="Create my account and continue" Command="{Binding CreateAccountCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
