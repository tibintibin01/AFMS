<UserControl x:Class="AFMS.App.Views.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!--
          A PasswordBox cannot show its own text, so a plain TextBox sits in the same
          cell and the eye toggle swaps which one is visible. Both write back to the
          Password property, so the caller only ever binds to that.
        -->
        <PasswordBox x:Name="Masked" Padding="9,5,34,5" PasswordChanged="OnMaskedChanged" />
        <TextBox x:Name="Plain" Padding="9,5,34,5" Visibility="Collapsed" TextChanged="OnPlainChanged" />
        <ToggleButton x:Name="Reveal" Style="{StaticResource RevealToggleStyle}"
                      HorizontalAlignment="Right" Margin="0,0,4,0"
                      Checked="OnRevealChanged" Unchecked="OnRevealChanged"
                      ToolTip="Show password"
                      AutomationProperties.Name="Show or hide the password" />
    </Grid>
</UserControl>
