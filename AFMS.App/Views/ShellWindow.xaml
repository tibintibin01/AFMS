<Window x:Class="AFMS.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:AFMS.App.ViewModels"
        xmlns:views="clr-namespace:AFMS.App.Views"
        Title="AFMS – Accountable Forms Management System"
        Width="1240" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:PlaceholderPageViewModel}">
            <views:PlaceholderPageView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource NavyBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,25,20,22">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource GoldBrush}">
                            <TextBlock Text="AF" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,2,0,0">
                            <TextBlock Text="AFMS" Foreground="White" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="TREASURY OFFICE" Foreground="#AFC0CF" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MAIN MENU" Foreground="#8299AD" FontSize="10" FontWeight="SemiBold" Margin="24,12,0,8" />
                    <Button Content="Dashboard" Command="{Binding DashboardCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Accountable Forms" Command="{Binding AccountableFormsCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Transactions" Command="{Binding TransactionsCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Collectors" Command="{Binding CollectorsCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <Button Content="Reports" Command="{Binding ReportsCommand}" Style="{StaticResource NavigationButtonStyle}" />
                    <TextBlock Text="SYSTEM" Foreground="#8299AD" FontSize="10" FontWeight="SemiBold" Margin="24,24,0,8"
                               Visibility="{Binding CanAccessAdministration, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Administration" Command="{Binding AdministrationCommand}" Style="{StaticResource NavigationButtonStyle}"
                            Visibility="{Binding CanAccessAdministration, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#36536D" BorderThickness="0,1,0,0" Padding="22,17">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="{Binding RoleSummary}" Foreground="#AFC0CF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        <Button Grid.Row="2" Content="Sign out" Command="{Binding LogoutCommand}" Foreground="#DDE7F0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0" Margin="0,12,0,0" Cursor="Hand" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Municipal Treasury Office" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#E9F5EE" CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
                        <TextBlock Text="OFFLINE READY" Foreground="#257247" FontSize="10" FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
