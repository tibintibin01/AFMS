<UserControl x:Class="AFMS.App.Views.CollectorLedgerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Collector Accountability Ledger" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Running accountability derived from immutable stock movements." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,18,0,12"><ComboBox Width="200" ItemsSource="{Binding Collectors}" SelectedItem="{Binding SelectedCollector}" Margin="0,0,7,0"/><ComboBox Width="180" ItemsSource="{Binding FormTypes}" SelectedItem="{Binding SelectedFormType}" Margin="0,0,7,0"/><ComboBox Width="150" ItemsSource="{Binding Barangays}" SelectedItem="{Binding SelectedBarangay}" Margin="0,0,7,0"/><TextBox Width="60" Text="{Binding MonthText}" ToolTip="Month 1-12" Margin="0,0,7,0"/><TextBox Width="70" Text="{Binding YearText}" ToolTip="Year" Margin="0,0,7,0"/><DatePicker Width="125" SelectedDate="{Binding FromDate}" ToolTip="From date" Margin="0,0,7,0"/><DatePicker Width="125" SelectedDate="{Binding ToDate}" ToolTip="To date" Margin="0,0,7,0"/><CheckBox Content="Outstanding only" IsChecked="{Binding OutstandingOnly}" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="Load ledger" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Entries}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="95"/><DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="140"/><DataGridTextColumn Header="Transaction" Binding="{Binding TransactionType}" Width="100"/><DataGridTextColumn Header="Form" Binding="{Binding FormType}" Width="*"/><DataGridTextColumn Header="Beginning" Binding="{Binding BeginningSerial}" Width="80"/><DataGridTextColumn Header="Ending" Binding="{Binding EndingSerial}" Width="80"/><DataGridTextColumn Header="In" Binding="{Binding QuantityIn}" Width="50"/><DataGridTextColumn Header="Out" Binding="{Binding QuantityOut}" Width="50"/><DataGridTextColumn Header="Balance" Binding="{Binding RunningBalance}" Width="65"/><DataGridTextColumn Header="Barangay" Binding="{Binding Barangay}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/></DataGrid.Columns></DataGrid>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" DataContext="{Binding Detail}"><TextBlock Text="Collector details" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="{Binding CollectorNumber, StringFormat=Collector no.: {0}}"/><TextBlock Text="{Binding Position}"/><TextBlock Text="{Binding OfficeOrDepartment}"/><TextBlock Text="{Binding TotalCurrentAccountability, StringFormat=Current accountability: {0:N0}}" FontSize="15" FontWeight="Bold" Margin="0,12,0,0"/><Separator Margin="0,12"/><TextBlock Text="By form type" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ByFormType}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="By barangay" FontWeight="SemiBold" Margin="0,12,0,0"/><ItemsControl ItemsSource="{Binding ByBarangay}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Outstanding forms" FontWeight="SemiBold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding OutstandingForms}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding FormType}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
        </Grid><TextBlock Grid.Row="3" Text="{Binding Message}" Margin="0,10,0,0" Style="{StaticResource NotificationTextStyle}"/>
    </Grid>
</UserControl>
