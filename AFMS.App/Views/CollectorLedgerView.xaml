<UserControl x:Class="AFMS.App.Views.CollectorLedgerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Collector Accountability Ledger" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Running accountability derived from immutable stock movements." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,18,0,12">
            <StackPanel Width="200" Margin="0,0,7,0"><TextBlock Text="Collector" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Collectors}" SelectedItem="{Binding SelectedCollector}"/></StackPanel>
            <StackPanel Width="180" Margin="0,0,7,0"><TextBlock Text="Form type" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding FormTypes}" SelectedItem="{Binding SelectedFormType}"/></StackPanel>
            <StackPanel Width="160" Margin="0,0,7,0"><TextBlock Text="Barangay" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Barangays}" SelectedItem="{Binding SelectedBarangay}"/></StackPanel>
            <StackPanel Width="75" Margin="0,0,7,0"><TextBlock Text="Month" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding MonthText}" MaxLength="2" ToolTip="Month 1-12"/></StackPanel>
            <StackPanel Width="90" Margin="0,0,7,0"><TextBlock Text="Year" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding YearText}" MaxLength="4"/></StackPanel>
            <StackPanel Width="150" Margin="0,0,7,0"><TextBlock Text="From date" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding FromDate}" SelectedDateFormat="Short"/></StackPanel>
            <StackPanel Width="150" Margin="0,0,7,0"><TextBlock Text="To date" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding ToDate}" SelectedDateFormat="Short"/></StackPanel>
            <CheckBox Content="Outstanding only" IsChecked="{Binding OutstandingOnly}" VerticalAlignment="Top" Margin="0,29,10,0"/><Button Content="Load ledger" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition MinWidth="400"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Entries}" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="105"/><DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="145"/><DataGridTextColumn Header="Transaction" Binding="{Binding TransactionType}" Width="115"/><DataGridTextColumn Header="Form type" Binding="{Binding FormType}" Width="140"/><DataGridTextColumn Header="Beginning serial" Binding="{Binding BeginningSerial}" Width="115"/><DataGridTextColumn Header="Ending serial" Binding="{Binding EndingSerial}" Width="110"/><DataGridTextColumn Header="Quantity in" Binding="{Binding QuantityIn}" Width="85"/><DataGridTextColumn Header="Quantity out" Binding="{Binding QuantityOut}" Width="90"/><DataGridTextColumn Header="Balance" Binding="{Binding RunningBalance}" Width="80"/><DataGridTextColumn Header="Barangay" Binding="{Binding Barangay}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/></DataGrid.Columns></DataGrid>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" DataContext="{Binding Detail}"><TextBlock Text="Collector details" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="{Binding CollectorNumber, StringFormat=Collector no.: {0}}"/><TextBlock Text="{Binding Position}"/><TextBlock Text="{Binding OfficeOrDepartment}"/><TextBlock Text="{Binding TotalCurrentAccountability, StringFormat=Current accountability: {0:N0}}" FontSize="15" FontWeight="Bold" Margin="0,12,0,0"/><Separator Margin="0,12"/><TextBlock Text="By form type" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ByFormType}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="By barangay" FontWeight="SemiBold" Margin="0,12,0,0"/><ItemsControl ItemsSource="{Binding ByBarangay}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Outstanding forms" FontWeight="SemiBold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding OutstandingForms}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding FormType}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
        </Grid><TextBlock Grid.Row="3" Text="{Binding Message}" Margin="0,10,0,0" Style="{StaticResource NotificationTextStyle}"/>
    </Grid>
</UserControl>
