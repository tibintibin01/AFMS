<UserControl x:Class="AFMS.App.Views.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Stock Inventory" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Find any booklet—or any individual receipt number—and review its complete accountability." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,12">
            <WrapPanel>
                <StackPanel Width="300" Margin="0,0,8,0"><TextBlock Text="Search" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reference, form type, collector, or storage location"/></StackPanel>
                <StackPanel Width="250" Margin="0,0,8,0"><TextBlock Text="Form type" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding FormTypes}" SelectedItem="{Binding SelectedFormType}"/></StackPanel>
                <StackPanel Width="105" Margin="0,0,8,0"><TextBlock Text="Series year" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SeriesYearText}" MaxLength="4"/></StackPanel>
                <StackPanel Width="160" Margin="0,0,8,0"><TextBlock Text="Receipt serial" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SerialNumberText}" ToolTip="Individual receipt serial number"/></StackPanel>
                <Button Content="Search inventory" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" VerticalAlignment="Bottom" MinWidth="145"/>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <StackPanel Width="165" Margin="0,0,8,0"><TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding InventoryStatuses}" SelectedItem="{Binding SelectedInventoryStatus}"/></StackPanel>
                <StackPanel Width="190" Margin="0,0,8,0"><TextBlock Text="Collector" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Collectors}" SelectedItem="{Binding SelectedCollector}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,14,0"><TextBlock Text="Barangay" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Barangays}" SelectedItem="{Binding SelectedBarangay}"/></StackPanel>
                <StackPanel Width="150" Margin="0,0,8,0"><TextBlock Text="Received from" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding ReceivedFrom}" SelectedDateFormat="Short"/></StackPanel>
                <StackPanel Width="150" Margin="0,0,14,0"><TextBlock Text="Received through" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding ReceivedTo}" SelectedDateFormat="Short"/></StackPanel>
                <CheckBox Content="Available only" IsChecked="{Binding AvailableOnly}" VerticalAlignment="Top" Margin="0,29,14,0"/>
                <CheckBox Content="Outstanding only" IsChecked="{Binding OutstandingOnly}" VerticalAlignment="Top" Margin="0,29,0,0"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedBooklet}" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Form type" Binding="{Binding FormType}" Width="180"/>
                    <DataGridTextColumn Header="Year" Binding="{Binding SeriesYear}" Width="70"/>
                    <DataGridTextColumn Header="Booklet" Binding="{Binding BookletNumber}" Width="90"/>
                    <DataGridTextColumn Header="Beginning serial" Binding="{Binding BeginningSerial}" Width="115"/>
                    <DataGridTextColumn Header="Ending serial" Binding="{Binding EndingSerial}" Width="110"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalQuantity}" Width="75"/>
                    <DataGridTextColumn Header="Used" Binding="{Binding UsedQuantity}" Width="70"/>
                    <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingQuantity}" Width="95"/>
                    <DataGridTextColumn Header="Current holder" Binding="{Binding CurrentHolder}" Width="150"/>
                    <DataGridTextColumn Header="Barangay" Binding="{Binding Barangay}" Width="130"/>
                    <DataGridTextColumn Header="Date received" Binding="{Binding DateReceived, StringFormat={}{0:MMM dd, yyyy}}" Width="120"/>
                    <DataGridTextColumn Header="Date issued" Binding="{Binding DateIssued, StringFormat={}{0:MMM dd, yyyy}}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                    <DataGridTextColumn Header="Storage location" Binding="{Binding StorageLocation}" Width="140"/>
                    <DataGridTextColumn Header="Last movement" Binding="{Binding LastMovementDate, StringFormat={}{0:MMM dd, yyyy HH:mm}}" Width="160"/>
                    <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Margin="16,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Inventory detail" FontSize="19" FontWeight="SemiBold"/><Button Content="Load selected details" Command="{Binding ViewDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,10"/></StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding Detail}">
                            <TextBlock Text="{Binding Booklet.FormType}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Booklet.BeginningSerial, StringFormat=Beginning: {0}}" Margin="0,8,0,0"/><TextBlock Text="{Binding Booklet.EndingSerial, StringFormat=Ending: {0}}"/>
                            <TextBlock Text="{Binding Booklet.Status, StringFormat=Status: {0}}"/><TextBlock Text="{Binding CurrentAccountability, StringFormat=Current accountability: {0}}" TextWrapping="Wrap"/>
                            <Separator Margin="0,12"/><TextBlock Text="Original receiving" FontWeight="SemiBold"/><TextBlock Text="{Binding ReceivingReference}"/><TextBlock Text="{Binding ReceivingDate, StringFormat={}{0:MMM dd, yyyy}}"/><TextBlock Text="{Binding ReceivingSource}" TextWrapping="Wrap"/><TextBlock Text="{Binding SourceDocumentNumber}"/>
                            <Separator Margin="0,12"/><TextBlock Text="Movement history" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding Movements}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,7"><StackPanel><TextBlock Text="{Binding MovementType}" FontWeight="SemiBold"/><TextBlock Text="{Binding OccurredAt, StringFormat={}{0:MMM dd, yyyy HH:mm}}"/><TextBlock Text="{Binding ReferenceNumber}"/><TextBlock Text="{Binding Destination}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="Usage ranges" FontWeight="SemiBold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding UsageRanges}"/>
                            <TextBlock Text="Exceptions" FontWeight="SemiBold" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding Exceptions}"/>
                            <TextBlock Text="{Binding Booklet.Remarks}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Message}" Margin="0,10,0,0" Style="{StaticResource NotificationTextStyle}"/>
    </Grid>
</UserControl>
