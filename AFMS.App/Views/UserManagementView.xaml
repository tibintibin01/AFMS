<UserControl x:Class="AFMS.App.Views.UserManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="User Management" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Administrator-only account, role, password, and activity controls." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search username or full name" Margin="0,0,10,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" IsDefault="True"/><Button Grid.Column="3" Content="Create user" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,8,0,10"><DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/><DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="170"/>
                    <DataGridTextColumn Header="Linked collector" Binding="{Binding LinkedCollectorName}" Width="150"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/><DataGridTextColumn Header="Last login" Binding="{Binding LastLogin, StringFormat=g}" Width="130"/>
                    <DataGridTextColumn Header="Date created" Binding="{Binding DateCreated, StringFormat=g}" Width="130"/><DataGridTextColumn Header="Failed logins" Binding="{Binding FailedLoginCount}" Width="85"/>
                </DataGrid.Columns></DataGrid>
                <TextBlock Grid.Row="1" Text="No users match the current filters." Style="{StaticResource EmptyStateTextStyle}"/>
                <WrapPanel Grid.Row="2"><Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Reset password" Command="{Binding ResetPasswordCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Activate / Deactivate" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="View activity" Command="{Binding ViewActivityCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Text="{Binding Message}" Margin="18,9,0,0" Style="{StaticResource NotificationTextStyle}"/></WrapPanel>
            </Grid>
            <Border Grid.Column="1" Width="380" Margin="18,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Account details" FontSize="19" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <StackPanel Visibility="{Binding IsProfileMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Username *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Username}" IsEnabled="{Binding IsNewUser}"/>
                            <TextBlock Text="Full name *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding FullName}"/><TextBlock Text="Linked collector" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Collectors}" SelectedItem="{Binding SelectedCollector}"/>
                            <TextBlock Text="Role *" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name"/><CheckBox Content="Active" IsChecked="{Binding EditorIsActive}" Margin="0,14,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NeedsPassword, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Temporary password *" Style="{StaticResource FieldLabelStyle}"/><PasswordBox PasswordChanged="HandlePasswordChanged" MaxLength="128"/>
                            <TextBlock Text="Confirm password *" Style="{StaticResource FieldLabelStyle}"/><PasswordBox PasswordChanged="HandleConfirmPasswordChanged" MaxLength="128"/>
                            <TextBlock Text="At least 12 characters with uppercase, lowercase, a number, and a symbol." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <CheckBox Content="Force password change at next login" IsChecked="{Binding MustChangePassword}" Margin="0,14,0,0"/>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,14,0,0" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Selected user activity" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Activity}" RowHeight="32"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding OccurredAt, StringFormat=g}" Width="140"/><DataGridTextColumn Header="Action" Binding="{Binding ActivityType}" Width="130"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
