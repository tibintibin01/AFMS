<UserControl x:Class="AFMS.App.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Items" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Everything you track, from bond paper to accountable form booklets." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,10,0" AutomationProperties.Name="Search items"
                     ToolTip="Search by code, name, or category"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Margin="0,0,10,0" AutomationProperties.Name="Filter by status"
                      ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" />
            <CheckBox Grid.Column="2" Content="Low stock only" Margin="0,0,14,0"
                      VerticalAlignment="Center" IsChecked="{Binding ShowLowOnly}" />
            <Button Grid.Column="3" Content="Search" Margin="0,0,10,0" IsDefault="True"
                    Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="4" Content="Add item" Command="{Binding AddCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Height="3" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <DataGrid Grid.Row="1" Margin="0,8,0,10" ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding Selected}" AutomationProperties.Name="Items">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                    <Setter Property="Background" Value="#FFF6ED" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="105" />
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" />
                        <DataGridTextColumn Header="Received" Width="90"
                                            Binding="{Binding QuantityIn, StringFormat={}{0:N0}}"
                                            ElementStyle="{StaticResource NumericCellStyle}" />
                        <DataGridTextColumn Header="Released" Width="90"
                                            Binding="{Binding QuantityOut, StringFormat={}{0:N0}}"
                                            ElementStyle="{StaticResource NumericCellStyle}" />
                        <DataGridTextColumn Header="On hand" Width="90"
                                            Binding="{Binding OnHand, StringFormat={}{0:N0}}"
                                            ElementStyle="{StaticResource NumericBoldCellStyle}" />
                        <DataGridCheckBoxColumn Header="Serials" Binding="{Binding TracksSerials}" Width="64" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateTextStyle}"
                           Text="No items match the current filters.&#x0a;Use 'Add item' to create the first one." />

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="Edit" Margin="0,0,8,0" Command="{Binding EditCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="{Binding ToggleActiveLabel}" Command="{Binding ToggleActiveCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <TextBlock Margin="16,10,0,0" Style="{StaticResource NotificationTextStyle}"
                               Text="{Binding Message}" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Width="370" Margin="18,0,0,0" Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Item code *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Code}" MaxLength="50"
                                     AutomationProperties.Name="Item code"
                                     ToolTip="A short code, such as AF51 or PAPER-A4" />

                            <TextBlock Text="Item name *" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Name}" MaxLength="200"
                                     AutomationProperties.Name="Item name" />

                            <TextBlock Text="Unit of measure *" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox IsEditable="True" Text="{Binding Unit}" ItemsSource="{Binding Units}"
                                      AutomationProperties.Name="Unit of measure"
                                      ToolTip="pcs, box, ream, booklet, and so on" />

                            <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Category}" MaxLength="100"
                                     AutomationProperties.Name="Category" />

                            <TextBlock Text="Warn me when stock reaches" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ReorderLevel}" AutomationProperties.Name="Low stock level"
                                     ToolTip="Leave at 0 to turn the low-stock warning off" />

                            <Border Background="{StaticResource NavyLightBrush}" CornerRadius="7"
                                    Padding="12" Margin="0,16,0,0">
                                <StackPanel>
                                    <CheckBox Content="This item has serial numbers"
                                              IsChecked="{Binding TracksSerials}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Turn this on for receipt booklets and forms. AFMS will then ask for the serial range and warn you before the same serial goes out twice." />
                                </StackPanel>
                            </Border>

                            <CheckBox Content="Show in the pick lists" Margin="0,16,0,0"
                                      IsChecked="{Binding EditorIsActive}" />

                            <TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="60"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="Remarks" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
