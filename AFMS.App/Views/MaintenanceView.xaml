<UserControl x:Class="AFMS.App.Views.MaintenanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Security and Maintenance" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Validated backups, controlled restoration, and dual-authorized fiscal-year closing." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding Message}" Style="{StaticResource NotificationTextStyle}" Margin="0,8,0,6"/></StackPanel>
    <TabControl Grid.Row="2">
      <TabItem Header="Backup and Restore" Visibility="{Binding CanBackupAndRestore, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#FFF8E7" BorderBrush="#E2C36B" BorderThickness="1" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding BackupStatus.Options.LocationWarning}" TextWrapping="Wrap"/><TextBlock Text="{Binding BackupStatus.Options.BackupFolder, StringFormat=Backup folder: {0}}" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding BackupStatus.LastSuccessfulBackup, StringFormat=Last validated backup: {0:g}}"/></StackPanel></Border>
        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button Content="Create validated backup" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Choose backup file" Command="{Binding BrowseRestoreCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Validate selected" Command="{Binding ValidateBackupCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Restore selected" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBox Width="280" Margin="12,0,0,0" Text="{Binding Reason}" ToolTip="Required reason for restore and fiscal-year decisions"/><TextBlock Text="{Binding RestoreFilePath}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" MaxWidth="280"/></WrapPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding BackupHistory}" SelectedItem="{Binding SelectedBackup}"><DataGrid.Columns><DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=g}" Width="145"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding FileSize, StringFormat=N0}" Width="95"/><DataGridCheckBoxColumn Header="Valid" Binding="{Binding IsValid}" Width="60"/><DataGridTextColumn Header="Created by" Binding="{Binding CreatedBy}" Width="110"/></DataGrid.Columns></DataGrid>
        </Grid></Grid></TabItem>
      <TabItem Header="Fiscal Years" Visibility="{Binding CanManageFiscalYears, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8"><TextBlock Text="Year" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox Width="70" Text="{Binding NewYear}"/><DatePicker Width="125" Margin="8,0" SelectedDate="{Binding StartDate}"/><DatePicker Width="125" SelectedDate="{Binding EndDate}"/><Button Content="Create fiscal year" Command="{Binding CreateFiscalYearCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0"/><Button Content="Pre-close check" Command="{Binding CheckCloseCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><CheckBox Content="Allow documented exceptions" IsChecked="{Binding AllowDocumentedExceptions}" VerticalAlignment="Center"/></WrapPanel>
        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding FiscalYears}" SelectedItem="{Binding SelectedYear}"><DataGrid.Columns><DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="75"/><DataGridTextColumn Header="Start" Binding="{Binding StartDate}" Width="100"/><DataGridTextColumn Header="End" Binding="{Binding EndDate}" Width="100"/><DataGridTextColumn Header="Workflow" Binding="{Binding Status}" Width="125"/><DataGridTextColumn Header="Closed" Binding="{Binding ClosedAt, StringFormat=g}" Width="140"/><DataGridTextColumn Header="Snapshot reference" Binding="{Binding SnapshotReference}" Width="*"/></DataGrid.Columns></DataGrid>
          <WrapPanel Grid.Row="1" Margin="0,8"><TextBox Width="330" Text="{Binding Reason}" ToolTip="Required reason or decision comments" Margin="0,0,8,0"/><Button Content="Request close" Command="{Binding RequestCloseCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Approve close" Command="{Binding ApproveCloseCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Request reopen" Command="{Binding RequestReopenCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Approve reopen" Command="{Binding ApproveReopenCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="View snapshot" Command="{Binding ViewSnapshotCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Snapshot}" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="Form type" Binding="{Binding FormType}" Width="*"/><DataGridTextColumn Header="Opening" Binding="{Binding BeginningQuantity}" Width="85"/><DataGridTextColumn Header="Additions" Binding="{Binding Additions}" Width="85"/><DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="75"/><DataGridTextColumn Header="Exceptions" Binding="{Binding Exceptions}" Width="85"/><DataGridTextColumn Header="Ending" Binding="{Binding EndingQuantity}" Width="85"/><DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingQuantity}" Width="95"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
