<UserControl x:Class="AFMS.App.Views.CollectorsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Collectors" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Maintain collector identities, appointments, and barangay assignments." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search collector number, name, or employee number" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding BarangayFilters}" SelectedItem="{Binding SelectedBarangayFilter}" Margin="0,0,10,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Margin="0,0,10,0"/>
            <Button Grid.Column="3" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" IsDefault="True"/><Button Grid.Column="4" Content="Add collector" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,8,0,10"><DataGrid.Columns>
                    <DataGridTextColumn Header="Collector no." Binding="{Binding CollectorNumber}" Width="110"/><DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="140"/><DataGridTextColumn Header="Barangay" Binding="{Binding BarangayName}" Width="140"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                </DataGrid.Columns></DataGrid>
                <TextBlock Grid.Row="1" Text="No collectors match the current filters." Style="{StaticResource EmptyStateTextStyle}"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="View details" Command="{Binding ViewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Deactivate / Reactivate" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Text="{Binding Message}" Margin="18,9,0,0" Style="{StaticResource NotificationTextStyle}"/></StackPanel>
            </Grid>
            <Border Grid.Column="1" Width="385" Margin="18,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Collector details" FontSize="19" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsReadOnlyMode, Converter={StaticResource BooleanNegationConverter}}">
                        <TextBlock Text="Collector number *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding CollectorNumber}"/><TextBlock Text="Full name *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding FullName}"/>
                        <TextBlock Text="Employee number" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding EmployeeNumber}"/><TextBlock Text="Position" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Position}"/>
                        <TextBlock Text="Office or department" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding OfficeOrDepartment}"/><TextBlock Text="Assigned barangay" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding BarangayFilters}" SelectedItem="{Binding EditorBarangay}"/>
                        <TextBlock Text="Contact number" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding ContactNumber}"/><TextBlock Text="Email address" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding EmailAddress}"/>
                        <TextBlock Text="Appointment / designation reference" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding AppointmentReference}"/>
                        <CheckBox Content="Active" IsChecked="{Binding EditorIsActive}" Margin="0,14,0,0"/><TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="60"/>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Close / Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
