<UserControl x:Class="AFMS.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="History" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Every line that came in or went out. Search it by item, person, or date." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,8,0" AutomationProperties.Name="Search history"
                     ToolTip="Search by reference, item, person, serial, or note"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding ItemFilter}"
                      SelectedItem="{Binding FilterItem}" DisplayMemberPath="Display"
                      AutomationProperties.Name="Filter by item" />
            <ComboBox Grid.Column="2" Margin="0,0,8,0" ItemsSource="{Binding PeopleFilter}"
                      SelectedItem="{Binding FilterPerson}" DisplayMemberPath="Display"
                      AutomationProperties.Name="Filter by person" />
            <ComboBox Grid.Column="3" Margin="0,0,8,0" ItemsSource="{Binding Directions}"
                      SelectedItem="{Binding SelectedDirection}"
                      AutomationProperties.Name="Filter by direction" />
            <Button Grid.Column="4" Content="Search" IsDefault="True" Command="{Binding SearchCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,7,0"
                       Foreground="{StaticResource MutedTextBrush}" />
            <DatePicker Grid.Column="1" Margin="0,0,10,0" SelectedDate="{Binding FromDate}"
                        AutomationProperties.Name="From date" />
            <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" Margin="0,0,7,0"
                       Foreground="{StaticResource MutedTextBrush}" />
            <DatePicker Grid.Column="3" Margin="0,0,12,0" SelectedDate="{Binding ToDate}"
                        AutomationProperties.Name="To date" />
            <Button Grid.Column="4" Content="This month" Margin="0,0,8,0"
                    Command="{Binding ThisMonthCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="5" Content="Last month" Margin="0,0,12,0"
                    Command="{Binding LastMonthCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="Include voided" VerticalAlignment="Center" Margin="0,0,12,0"
                          IsChecked="{Binding IncludeVoided}" />
                <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ProgressBar Height="3" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Rows}"
                      AutomationProperties.Name="In and out history">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Setter Property="Background" Value="#FAFAFA" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Width="105"
                                        Binding="{Binding Date, StringFormat=MMM d\, yyyy}" />
                    <DataGridTextColumn Header="In/Out" Binding="{Binding DirectionLabel}" Width="60" />
                    <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="130" />
                    <DataGridTextColumn Header="Code" Binding="{Binding ItemCode}" Width="95" />
                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65" />
                    <DataGridTextColumn Header="In" Width="65"
                                        Binding="{Binding QuantityIn, StringFormat={}{0:N0}}"
                                        ElementStyle="{StaticResource NumericCellStyle}" />
                    <DataGridTextColumn Header="Out" Width="65"
                                        Binding="{Binding QuantityOut, StringFormat={}{0:N0}}"
                                        ElementStyle="{StaticResource NumericCellStyle}" />
                    <DataGridTextColumn Header="Serials" Binding="{Binding SerialLabel}" Width="130"
                                        ElementStyle="{StaticResource MonospaceCellStyle}" />
                    <DataGridTextColumn Header="Who" Binding="{Binding PartyName}" Width="160" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="170" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateTextStyle}"
                       Text="Nothing matches these filters.&#x0a;Try clearing them or widening the dates." />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                           Text="{Binding RowCount, StringFormat={}{0:N0} line(s) shown}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                               Margin="0,0,20,0"
                               Text="{Binding TotalIn, StringFormat=Total in: {0:N0}}" />
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                               Text="{Binding TotalOut, StringFormat=Total out: {0:N0}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
