<UserControl x:Class="AFMS.App.Views.StockInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Stock In" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Record deliveries, transfers from another office, items handed back, and corrections." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,10,0" AutomationProperties.Name="Search stock-in entries"
                     ToolTip="Search by reference number, supplier, document number, or item"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <DatePicker Grid.Column="1" Margin="0,0,8,0" SelectedDate="{Binding FilterFrom}"
                        AutomationProperties.Name="From date" ToolTip="From date" />
            <DatePicker Grid.Column="2" Margin="0,0,10,0" SelectedDate="{Binding FilterTo}"
                        AutomationProperties.Name="To date" ToolTip="To date" />
            <Button Grid.Column="3" Content="Search" Margin="0,0,10,0" IsDefault="True"
                    Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="4" Content="Record stock in" Command="{Binding NewCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Height="3" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <DataGrid Grid.Row="1" Margin="0,8,0,10" ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding Selected}"
                          AutomationProperties.Name="Stock-in entries">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Voided">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Setter Property="Background" Value="#FAFAFA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="130" />
                        <DataGridTextColumn Header="Date" Width="105"
                                            Binding="{Binding EntryDate, StringFormat=MMM d\, yyyy}" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding SourceLabel}" Width="150" />
                        <DataGridTextColumn Header="From" Width="*">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Path="SourceName" TargetNullValue="" />
                                    <Binding Path="ReturnedByRecipientName" TargetNullValue="" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Document" Binding="{Binding DocumentNumber}" Width="120" />
                        <DataGridTextColumn Header="Total" Width="80"
                                            Binding="{Binding TotalQuantity, StringFormat={}{0:N0}}"
                                            ElementStyle="{StaticResource NumericBoldCellStyle}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateTextStyle}"
                           Text="Nothing recorded yet for these filters.&#x0a;Use 'Record stock in' when a delivery arrives." />

                <!-- Details of the highlighted entry -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10"
                        Visibility="{Binding Selected, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                                   Text="{Binding Selected.ReferenceNumber, StringFormat=Items on {0}}" />
                        <DataGrid ItemsSource="{Binding Selected.Lines}" MaxHeight="140" Margin="0,8,0,0"
                                  AutomationProperties.Name="Items on the selected entry">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding ItemCode}" Width="100" />
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                                <DataGridTextColumn Header="Qty" Width="70"
                                                    Binding="{Binding Quantity, StringFormat={}{0:N0}}"
                                                    ElementStyle="{StaticResource NumericCellStyle}" />
                                <DataGridTextColumn Header="Serials" Binding="{Binding SerialLabel}" Width="140"
                                                    ElementStyle="{StaticResource MonospaceCellStyle}" />
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic"
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding Selected.VoidReason, Converter={StaticResource NullToVisibilityConverter}}"
                                   Text="{Binding Selected.VoidReason, StringFormat=Voided: {0}}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="Edit" Margin="0,0,8,0" Command="{Binding EditCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Void" Command="{Binding VoidCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Keeps the entry on file but stops it counting" />
                    <TextBlock Margin="16,10,0,0" Style="{StaticResource NotificationTextStyle}"
                               Text="{Binding Message}" />
                </StackPanel>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="1" Width="560" Margin="18,0,0,0" Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Date received *" Style="{StaticResource FieldLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding EntryDate}"
                                                AutomationProperties.Name="Date received" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="What kind of entry *" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                                              AutomationProperties.Name="Kind of entry" />
                                </StackPanel>
                            </Grid>

                            <!-- Only shown for a return, because that is what clears accountability -->
                            <StackPanel Visibility="{Binding IsReturn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Returned by *" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding ReturnedBy}"
                                          DisplayMemberPath="Display"
                                          AutomationProperties.Name="Returned by"
                                          ToolTip="Choosing the person here is what clears what they were holding" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsReturn, Converter={StaticResource BooleanToCollapsedConverter}}">
                                <TextBlock Text="{Binding SourceNameLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding SourceName}" MaxLength="200"
                                         AutomationProperties.Name="Source" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Document number" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding DocumentNumber}" MaxLength="100"
                                             AutomationProperties.Name="Document number"
                                             ToolTip="Delivery receipt, purchase order, invoice, or memo number" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Received by" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ReceivedBy}" MaxLength="200"
                                             AutomationProperties.Name="Received by" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Items received *" Style="{StaticResource FieldLabelStyle}" />
                            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                                      Style="{StaticResource EditableGridStyle}" MinHeight="120" MaxHeight="230"
                                      AutomationProperties.Name="Items received">
                                <DataGrid.Columns>
                                    <DataGridComboBoxColumn Header="Item" Width="2*"
                                                            DisplayMemberPath="Display"
                                                            SelectedItemBinding="{Binding Item, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource" Value="{Binding ItemOptions}" />
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource" Value="{Binding ItemOptions}" />
                                                <Setter Property="IsEditable" Value="True" />
                                                <Setter Property="IsTextSearchEnabled" Value="True" />
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Qty" Width="70"
                                                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                        ElementStyle="{StaticResource NumericCellStyle}" />
                                    <DataGridTextColumn Header="Serial from" Width="95"
                                                        Binding="{Binding SerialFrom, UpdateSourceTrigger=LostFocus}"
                                                        ElementStyle="{StaticResource MonospaceCellStyle}" />
                                    <DataGridTextColumn Header="Serial to" Width="95"
                                                        Binding="{Binding SerialTo, UpdateSourceTrigger=LostFocus}"
                                                        ElementStyle="{StaticResource MonospaceCellStyle}" />
                                    <DataGridTextColumn Header="Remarks" Width="*"
                                                        Binding="{Binding Remarks, UpdateSourceTrigger=LostFocus}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Add line" Margin="0,0,8,0" Command="{Binding AddLineCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="1" Content="Remove line"
                                        Command="{Binding RemoveLineCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                                           Text="{Binding EditorTotal, StringFormat=Total: {0:N0}}" />
                            </Grid>

                            <TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="52"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="Remarks for the whole entry" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Save entry" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
