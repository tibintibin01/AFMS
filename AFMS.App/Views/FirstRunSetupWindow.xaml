<Window x:Class="AFMS.App.Views.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:AFMS.App.Behaviors"
        Title="AFMS Initial Setup"
        Width="720" Height="650" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource NavyBrush}">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="AF" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="AFMS" Foreground="White" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Accountable Forms Management System" Foreground="#DDE7F0" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Municipal Treasury Office" Foreground="#AFC0CF" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="46,42" MaxWidth="390">
                <TextBlock Text="Secure initial setup" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Create the first administrator account. No default password is stored or generated." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,28" />

                <TextBlock Text="Display name" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,16,0,6" />
                <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" />
                <TextBlock Text="At least 12 characters with upper/lowercase, a number, and a symbol." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="Confirm password" FontWeight="SemiBold" Margin="0,16,0,6" />
                <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" MinHeight="24" Margin="0,14,0,8" />
                <Button Content="Create administrator" Command="{Binding CreateAdministratorCommand}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
