<UserControl x:Class="AFMS.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings &amp; Backup" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Office details for printed forms, your backup copies, and the record of who did what." />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,18,0,0">

            <!-- Office details -->
            <TabItem Header="Office details">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="These appear on the header of every printed report and release slip."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,6" />

                        <TextBlock Text="Office name *" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding OfficeName}" MaxLength="200"
                                 AutomationProperties.Name="Office name" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Municipality" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding MunicipalityName}" MaxLength="200"
                                         AutomationProperties.Name="Municipality" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Province" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding ProvinceName}" MaxLength="200"
                                         AutomationProperties.Name="Province" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Head of office" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding HeadOfOffice}" MaxLength="200"
                                 AutomationProperties.Name="Head of office" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Default 'Prepared by'" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding PreparedBy}" MaxLength="200"
                                         AutomationProperties.Name="Default prepared by" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Default 'Certified correct by'"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding CertifiedBy}" MaxLength="200"
                                         AutomationProperties.Name="Default certified correct by" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Where exported reports are saved" Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ReportFolder}" Margin="0,0,8,0"
                                     AutomationProperties.Name="Report folder" />
                            <Button Grid.Column="1" Content="Browse..."
                                    Command="{Binding BrowseReportFolderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <TextBlock Text="Lock the app after this many idle minutes"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SessionTimeoutMinutes}" MaxLength="4" MaxWidth="120"
                                 HorizontalAlignment="Left" AutomationProperties.Name="Idle minutes before locking"
                                 ToolTip="Between 5 and 480 minutes" />

                        <Button Content="Save settings" Margin="0,22,0,0" HorizontalAlignment="Left"
                                MinWidth="170" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource NotificationTextStyle}"
                                   Text="{Binding Message}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Account -->
            <TabItem Header="Account">
                <StackPanel Margin="22" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Password" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,16"
                               Text="Change the password used to sign in to AFMS on this computer." />
                    <Button Content="Change password..." HorizontalAlignment="Left" MinWidth="180"
                            Command="{Binding ChangePasswordCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </TabItem>

            <!-- Backups -->
            <TabItem Header="Backup &amp; restore">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource WarningBannerStyle}" Margin="0,0,0,14"
                            Visibility="{Binding BackupOverdue, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource WarningTextStyle}" Text="{Binding BackupSummary}" />
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BackupSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <CheckBox Content="Take one backup automatically each day" Margin="0,9,0,0"
                                      IsChecked="{Binding DailyBackupEnabled}" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <TextBlock Text="Keep automatic backups for" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Text="{Binding BackupRetentionDays}" Width="70" Margin="8,0"
                                         AutomationProperties.Name="Backup retention days" />
                                <TextBlock Text="days" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Back up now" MinWidth="160" Command="{Binding BackupNowCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="Open backup folder" MinWidth="160" Margin="0,8,0,0"
                                    Command="{Binding OpenBackupFolderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                              AutomationProperties.Name="Backup files">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="115" />
                            <DataGridTextColumn Header="Created" Width="165"
                                                Binding="{Binding CreatedAt, StringFormat=MMM d\, yyyy h:mm tt}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="90"
                                                ElementStyle="{StaticResource NumericCellStyle}" />
                            <DataGridCheckBoxColumn Header="Checked" Binding="{Binding IsValid}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Border Style="{StaticResource CardStyle}" Padding="14" Background="#FFF8F7"
                                BorderBrush="#E8BBB7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="620"
                                           Foreground="{StaticResource DangerBrush}"
                                           Text="Restoring replaces every record with the contents of the chosen backup. A safety copy of your current data is taken first and AFMS restarts to finish." />
                                <Button Grid.Column="1" Content="Restore from backup..." MinWidth="190"
                                        Command="{Binding RestoreCommand}"
                                        Style="{StaticResource DangerButtonStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Audit trail -->
            <TabItem Header="Record of changes">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"
                               Text="Every action is written here and cannot be edited or deleted, even outside the app. This is the trail an auditor would ask for." />

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Margin="0,0,10,0" AutomationProperties.Name="Search the record of changes"
                                 ToolTip="Search by description, reference number, or user"
                                 Text="{Binding AuditSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Search" IsDefault="True"
                                Command="{Binding SearchAuditCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding AuditEntries}"
                              AutomationProperties.Name="Record of changes">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Width="165"
                                                Binding="{Binding OccurredAt, StringFormat=MMM d\, yyyy h:mm tt}" />
                            <DataGridTextColumn Header="Who" Binding="{Binding User}" Width="120" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Activity}" Width="150" />
                            <DataGridTextColumn Header="What happened" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="130" />
                            <DataGridTextColumn Header="Computer" Binding="{Binding MachineName}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Previous" Margin="0,0,8,0"
                                Command="{Binding PreviousAuditPageCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Next" Margin="0,0,14,0" Command="{Binding NextAuditPageCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding AuditPageLabel}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
