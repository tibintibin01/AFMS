<UserControl x:Class="AFMS.App.Views.ReleasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Release" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Record what went out and who received it. AFMS blocks a serial that is still with someone." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,10,0" AutomationProperties.Name="Search releases"
                     ToolTip="Search by reference number, person, purpose, or item"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding PeopleFilter}"
                      SelectedItem="{Binding FilterPerson}" DisplayMemberPath="Display"
                      AutomationProperties.Name="Filter by person" />
            <DatePicker Grid.Column="2" Margin="0,0,8,0" SelectedDate="{Binding FilterFrom}"
                        AutomationProperties.Name="From date" ToolTip="From date" />
            <DatePicker Grid.Column="3" Margin="0,0,10,0" SelectedDate="{Binding FilterTo}"
                        AutomationProperties.Name="To date" ToolTip="To date" />
            <Button Grid.Column="4" Content="Search" Margin="0,0,10,0" IsDefault="True"
                    Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="5" Content="New release" Command="{Binding NewCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Height="3" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <DataGrid Grid.Row="1" Margin="0,8,0,10" ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding Selected}"
                          AutomationProperties.Name="Releases">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Voided">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Setter Property="Background" Value="#FAFAFA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="135" />
                        <DataGridTextColumn Header="Date" Width="105"
                                            Binding="{Binding ReleaseDate, StringFormat=MMM d\, yyyy}" />
                        <DataGridTextColumn Header="Released to" Binding="{Binding RecipientName}" Width="*" />
                        <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="180" />
                        <DataGridTextColumn Header="Total" Width="80"
                                            Binding="{Binding TotalQuantity, StringFormat={}{0:N0}}"
                                            ElementStyle="{StaticResource NumericBoldCellStyle}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateTextStyle}"
                           Text="No releases match these filters.&#x0a;Use 'New release' to record items going out." />

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10"
                        Visibility="{Binding Selected, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                                   Text="{Binding Selected.ReferenceNumber, StringFormat=Items on {0}}" />
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12">
                            <Run Text="Released by" /><Run Text=" " />
                            <Run Text="{Binding Selected.ReleasedBy, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="   ·   Received by" /><Run Text=" " />
                            <Run Text="{Binding Selected.ReceivedBy, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding Selected.Lines}" MaxHeight="140" Margin="0,8,0,0"
                                  AutomationProperties.Name="Items on the selected release">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding ItemCode}" Width="100" />
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                                <DataGridTextColumn Header="Qty" Width="70"
                                                    Binding="{Binding Quantity, StringFormat={}{0:N0}}"
                                                    ElementStyle="{StaticResource NumericCellStyle}" />
                                <DataGridTextColumn Header="Serials" Binding="{Binding SerialLabel}" Width="140"
                                                    ElementStyle="{StaticResource MonospaceCellStyle}" />
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic"
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding Selected.VoidReason, Converter={StaticResource NullToVisibilityConverter}}"
                                   Text="{Binding Selected.VoidReason, StringFormat=Voided: {0}}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="Print slip" Margin="0,0,8,0" Command="{Binding PrintSlipCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Saves a signed release slip as PDF" />
                    <Button Content="Edit" Margin="0,0,8,0" Command="{Binding EditCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Void" Command="{Binding VoidCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="Keeps the release on file and frees its serials again" />
                    <TextBlock Margin="16,10,0,0" MaxWidth="420"
                               Style="{StaticResource NotificationTextStyle}" Text="{Binding Message}" />
                </StackPanel>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="1" Width="580" Margin="18,0,0,0" Style="{StaticResource CardStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Date released *" Style="{StaticResource FieldLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding ReleaseDate}"
                                                AutomationProperties.Name="Date released" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Released to *" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding Recipient}"
                                              DisplayMemberPath="Display" IsEditable="False"
                                              AutomationProperties.Name="Person receiving the items" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Purpose" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Purpose}" MaxLength="500"
                                     AutomationProperties.Name="Purpose"
                                     ToolTip="Why the items are being released" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Released by *" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ReleasedBy}" MaxLength="200"
                                             AutomationProperties.Name="Released by"
                                             ToolTip="Printed on the 'released by' signature line" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Received by *" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ReceivedBy}" MaxLength="200"
                                             AutomationProperties.Name="Received by"
                                             ToolTip="Printed on the 'received by' signature line" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Items going out *" Style="{StaticResource FieldLabelStyle}" />
                            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                                      Style="{StaticResource EditableGridStyle}" MinHeight="120" MaxHeight="220"
                                      AutomationProperties.Name="Items going out">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                <Setter Property="Background" Value="#FFF6ED" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridComboBoxColumn Header="Item" Width="2*"
                                                            DisplayMemberPath="Display"
                                                            SelectedItemBinding="{Binding Item, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource" Value="{Binding ItemOptions}" />
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource" Value="{Binding ItemOptions}" />
                                                <Setter Property="IsEditable" Value="True" />
                                                <Setter Property="IsTextSearchEnabled" Value="True" />
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridTextColumn Header="On hand" Binding="{Binding OnHandLabel}" Width="85"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource NumericCellStyle}" />
                                    <DataGridTextColumn Header="Qty" Width="70"
                                                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                        ElementStyle="{StaticResource NumericCellStyle}" />
                                    <DataGridTextColumn Header="Serial from" Width="95"
                                                        Binding="{Binding SerialFrom, UpdateSourceTrigger=LostFocus}"
                                                        ElementStyle="{StaticResource MonospaceCellStyle}" />
                                    <DataGridTextColumn Header="Serial to" Width="95"
                                                        Binding="{Binding SerialTo, UpdateSourceTrigger=LostFocus}"
                                                        ElementStyle="{StaticResource MonospaceCellStyle}" />
                                    <DataGridTextColumn Header="Remarks" Width="*"
                                                        Binding="{Binding Remarks, UpdateSourceTrigger=LostFocus}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- The duplicate-serial warning, one row per flagged line -->
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource WarningBannerStyle}" Margin="0,0,0,6"
                                                Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons"
                                                           Foreground="#C77700" Margin="0,0,9,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Warning}" MaxWidth="450"
                                                           Style="{StaticResource WarningTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Add line" Margin="0,0,8,0" Command="{Binding AddLineCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="1" Content="Remove line"
                                        Command="{Binding RemoveLineCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                                           Text="{Binding EditorTotal, StringFormat=Total: {0:N0}}" />
                            </Grid>

                            <TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="52"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="Remarks for the whole release" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource WarningBannerStyle}" Margin="0,12,0,0"
                            Visibility="{Binding HasSerialWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource WarningTextStyle}"
                                   Text="One or more serial ranges are still out with someone. Fix them, or record the return first." />
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Save release" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
