<UserControl x:Class="AFMS.App.Views.BrandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource NavyBrush}">
        <Grid Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource GoldBrush}"
                    HorizontalAlignment="Left">
                <TextBlock Text="AF" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource NavyDarkBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="AFMS Inventory" Foreground="White" FontSize="26" FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock Text="Records what comes in, what goes out, and who received it."
                           Foreground="#DDE7F0" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="Works offline. Nothing leaves this computer."
                           Foreground="#9FB6CB" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Municipal Treasury Office" Foreground="#8FA8BE"
                       FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
