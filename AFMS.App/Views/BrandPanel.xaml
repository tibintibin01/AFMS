<UserControl x:Class="AFMS.App.Views.BrandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One row of the "what this does" list. -->
        <Style x:Key="BrandFeatureIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="26" />
        </Style>
        <Style x:Key="BrandFeatureText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8DAEA" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                <GradientStop Color="#1B456C" Offset="0" />
                <GradientStop Color="#173B5E" Offset="0.55" />
                <GradientStop Color="#102D49" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Soft background geometry for depth. Purely decorative. -->
            <Ellipse Width="330" Height="330" Fill="#FFFFFF" Opacity="0.03"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-130,-120,0" />
            <Ellipse Width="210" Height="210" Fill="#D9A83E" Opacity="0.06"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-90,0,0,-70" />
            <Ellipse Width="120" Height="120" Stroke="#FFFFFF" StrokeThickness="1" Opacity="0.06"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,26,150" />

            <Grid Margin="34,30,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mark -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource GoldBrush}">
                        <TextBlock Text="AF" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource NavyDarkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AFMS" Foreground="White" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="INVENTORY RECORDS" Foreground="#8FA8BE" FontSize="9"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Message -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,26,0,0">
                    <TextBlock Foreground="White" FontSize="25" FontWeight="Bold" TextWrapping="Wrap"
                               LineHeight="32" Text="Every item accounted for." />

                    <Rectangle Width="42" Height="3" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                               Fill="{StaticResource GoldBrush}" Margin="0,14,0,0" />

                    <TextBlock Foreground="#B9CDDD" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                               Margin="0,16,0,0"
                               Text="What came in, what went out, and who received it." />

                    <StackPanel Margin="0,26,0,0">
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE896;" Style="{StaticResource BrandFeatureIcon}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BrandFeatureText}"
                                       Text="Log deliveries and returns" />
                        </Grid>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8EF;" Style="{StaticResource BrandFeatureIcon}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BrandFeatureText}"
                                       Text="See who still holds what" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE749;" Style="{StaticResource BrandFeatureIcon}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BrandFeatureText}"
                                       Text="Print reports ready to file" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="#FFFFFF" Opacity="0.10" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Municipal Treasury Office" Foreground="#8FA8BE" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#4CAF89" Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="OFFLINE" Foreground="#7FA0B8" FontSize="9.5"
                                       FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
