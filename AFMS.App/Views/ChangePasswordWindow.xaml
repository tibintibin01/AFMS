<Window x:Class="AFMS.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change your password"
        Width="470" Height="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="34">
        <TextBlock Text="Change your password" FontSize="21" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,22"
                   Text="Choose a new password before continuing." />

        <Label Content="_Current password" Target="{Binding ElementName=CurrentBox}"
               Padding="0,0,0,6" FontWeight="SemiBold" />
        <PasswordBox x:Name="CurrentBox" MaxLength="128" PasswordChanged="OnCurrentChanged"
                     AutomationProperties.Name="Current password" />

        <Label Content="_New password" Target="{Binding ElementName=NewBox}"
               Padding="0,15,0,6" FontWeight="SemiBold" />
        <PasswordBox x:Name="NewBox" MaxLength="128" PasswordChanged="OnNewChanged"
                     AutomationProperties.Name="New password" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0"
                   Text="At least 12 characters, with an uppercase letter, a lowercase letter, a number, and a symbol." />

        <Label Content="Type the new password a_gain" Target="{Binding ElementName=ConfirmBox}"
               Padding="0,15,0,6" FontWeight="SemiBold" />
        <PasswordBox x:Name="ConfirmBox" MaxLength="128" PasswordChanged="OnConfirmChanged"
                     AutomationProperties.Name="Confirm new password" />

        <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" MinHeight="34" Margin="0,15,0,10" />

        <Button Content="Save new password" Command="{Binding ChangeCommand}"
                Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
    </StackPanel>
</Window>
