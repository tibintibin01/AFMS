<Window x:Class="AFMS.App.Views.ChangePasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Width="500" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Border Background="White" Padding="38"><StackPanel>
        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource GoldBrush}" HorizontalAlignment="Left"><TextBlock Text="AF" FontSize="19" FontWeight="Bold" Foreground="{StaticResource NavyDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Password change required" FontSize="24" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock Text="Your administrator requires you to replace the temporary password before continuing." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,18"/>
        <TextBlock Text="Current password" Style="{StaticResource FieldLabelStyle}"/><PasswordBox PasswordChanged="HandleCurrentPasswordChanged" MaxLength="128"/>
        <TextBlock Text="New password" Style="{StaticResource FieldLabelStyle}"/><PasswordBox PasswordChanged="HandleNewPasswordChanged" MaxLength="128"/>
        <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabelStyle}"/><PasswordBox PasswordChanged="HandleConfirmPasswordChanged" MaxLength="128"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" MinHeight="34" Margin="0,12,0,4"/>
        <Button Content="Change password and continue" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"/>
    </StackPanel></Border>
</Window>
