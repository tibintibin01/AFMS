<Window x:Class="AFMS.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AFMS.App.Views"
        Title="Change your password"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="32">
        <TextBlock Text="Change your password" FontSize="20" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,20"
                   Text="Choose a new password before continuing." />

        <TextBlock Text="Current password" Padding="0,0,0,5" FontWeight="SemiBold" FontSize="12" />
        <views:RevealPasswordBox x:Name="CurrentBox" FieldName="Current password"
                                Password="{Binding CurrentPassword, Mode=TwoWay}" />

        <TextBlock Text="New password" Padding="0,14,0,5" FontWeight="SemiBold" FontSize="12" />
        <views:RevealPasswordBox x:Name="NewBox" FieldName="New password"
                                Password="{Binding NewPassword, Mode=TwoWay}" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                   Margin="0,6,0,0"
                   Text="At least 12 characters, with an uppercase letter, a lowercase letter, a number, and a symbol." />

        <TextBlock Text="Type the new password again" Padding="0,14,0,5" FontWeight="SemiBold" FontSize="12" />
        <views:RevealPasswordBox x:Name="ConfirmBox" FieldName="Confirm new password"
                                Password="{Binding ConfirmPassword, Mode=TwoWay}" />

        <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" MinHeight="32" Margin="0,14,0,8" />

        <Button Content="Save new password" Command="{Binding ChangeCommand}"
                Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" MinHeight="36" />
    </StackPanel>
</Window>
