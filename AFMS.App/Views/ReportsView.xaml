<UserControl x:Class="AFMS.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Reports" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Pick a report, check it on screen, then save it as PDF or Excel with the office header." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Choose a report" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Report" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                              AutomationProperties.Name="Report to run" />

                    <Border Background="{StaticResource NavyLightBrush}" CornerRadius="7" Padding="12"
                            Margin="0,12,0,0">
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="#34465A" />
                    </Border>

                    <StackPanel Visibility="{Binding NeedsItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Item" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                  DisplayMemberPath="Display" AutomationProperties.Name="Item" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding NeedsPerson, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Person" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                                  DisplayMemberPath="Display" AutomationProperties.Name="Person" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding SupportsDateRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="From date" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding FromDate}" AutomationProperties.Name="From date" />
                        <TextBlock Text="To date" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding ToDate}" AutomationProperties.Name="To date" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Leave the dates blank for the complete history." />
                    </StackPanel>

                    <Button Content="Show the report" Margin="0,20,0,0" Command="{Binding PreviewCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Save as PDF" Command="{Binding ExportPdfCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2" Content="Save as Excel" Command="{Binding ExportExcelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <TextBlock Margin="0,14,0,0" Style="{StaticResource NotificationTextStyle}"
                               Text="{Binding Message}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,20,20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding PreviewHeading}" Style="{StaticResource SectionTitleStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewTable}"
                              AutoGenerateColumns="True" FrozenColumnCount="1"
                              Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="Report preview" />

                    <TextBlock Grid.Row="1" IsHitTestVisible="False" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Choose a report on the left, then press 'Show the report'."
                               Visibility="{Binding HasPreview, Converter={StaticResource BooleanToCollapsedConverter}}" />

                    <!-- Totals, right-aligned in a row under the table instead of stacked text -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding PreviewTotals}" Margin="0,14,0,0"
                                  Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource NavyLightBrush}" CornerRadius="7"
                                        Padding="12,8" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource NavyBrush}"
                                                   Text="{Binding Value}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
