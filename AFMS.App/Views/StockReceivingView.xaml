<UserControl x:Class="AFMS.App.Views.StockReceivingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Stock Receiving" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Record accountable forms received and finalize them into controlled booklet inventory." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search reference, form type, or source" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" IsDefault="True"/>
            <Button Grid.Column="2" Content="New receiving draft" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="500"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" Margin="0,8,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="145"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding DateReceived, StringFormat={}{0:MMM dd, yyyy}}" Width="105"/>
                        <DataGridTextColumn Header="Form type" Binding="{Binding FormType}" Width="*" MinWidth="170"/>
                        <DataGridTextColumn Header="Series" Binding="{Binding SeriesYear}" Width="75"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="View" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Edit draft" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Submit" Command="{Binding SubmitCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Finalize" Command="{Binding FinalizeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Reverse" Command="{Binding ReverseCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Column="1" Margin="18,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Receiving transaction" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding ReferenceNumber}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/></StackPanel>
                        <Border Grid.Column="1" Background="#EEF3F7" CornerRadius="12" Padding="10,4" VerticalAlignment="Top"><TextBlock Text="{Binding EditorStatus}" FontSize="11" FontWeight="SemiBold"/></Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel IsEnabled="{Binding IsReadOnly, Converter={StaticResource BooleanNegationConverter}}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Date received *" Style="{StaticResource FieldLabelStyle}"/><DatePicker SelectedDate="{Binding DateReceived}"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Series year *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SeriesYear}" MaxLength="4"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Accountable form type *" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding FormTypes}" SelectedItem="{Binding SelectedFormType}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Source / issuing office *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Source}"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Source document no." Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding SourceDocumentNumber}"/></StackPanel>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Storage location *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding StorageLocation}"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Received by *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding ReceivedBy}"/></StackPanel>
                            </Grid>
                            <DockPanel Margin="0,15,0,6"><TextBlock Text="Receipt ranges" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Add range" Command="{Binding AddItemCommand}" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="10,5"/></DockPanel>
                            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsReadOnly="False" Height="180" RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Books" Binding="{Binding NumberOfBooklets, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="Per book" Binding="{Binding ReceiptsPerBooklet, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="Beginning" Binding="{Binding BeginningSerial, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Ending" Binding="{Binding EndingSerial, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalReceiptQuantity}" IsReadOnly="True" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Remove selected range" Command="{Binding RemoveItemCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="10,5" Margin="0,7,0,0"/>
                            <TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="55" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Close" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Save draft" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Message}" Margin="0,12,0,0" Style="{StaticResource NotificationTextStyle}"/>
    </Grid>
</UserControl>
