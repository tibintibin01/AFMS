<Window x:Class="AFMS.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="26">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,14" />
        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76"
                 VerticalContentAlignment="Top" MaxLength="1000"
                 AutomationProperties.Name="Your answer" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="OK" Click="OnOk" IsDefault="True" MinWidth="96"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
