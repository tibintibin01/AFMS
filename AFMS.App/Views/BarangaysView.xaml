<UserControl x:Class="AFMS.App.Views.BarangaysView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Barangays" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Maintain configurable geographic assignments for collectors." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search barangays" Margin="0,0,10,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" IsDefault="True"/><Button Grid.Column="3" Content="Add barangay" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,8,0,10"><DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Barangay name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Municipality" Binding="{Binding Municipality}" Width="160"/><DataGridTextColumn Header="Province" Binding="{Binding Province}" Width="140"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                </DataGrid.Columns></DataGrid>
                <TextBlock Grid.Row="1" Text="No barangays match the current filters." Style="{StaticResource EmptyStateTextStyle}"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Deactivate / Reactivate" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Text="{Binding Message}" Margin="18,9,0,0" Style="{StaticResource NotificationTextStyle}"/></StackPanel>
            </Grid>
            <Border Grid.Column="1" Width="350" Margin="18,0,0,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Barangay details" FontSize="19" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Barangay code *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Code}"/><TextBlock Text="Barangay name *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Name}"/>
                        <TextBlock Text="Municipality *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Municipality}"/><TextBlock Text="Province *" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Province}"/>
                        <CheckBox Content="Active" IsChecked="{Binding EditorIsActive}" Margin="0,14,0,0"/><TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}"/><TextBox Text="{Binding Remarks}" AcceptsReturn="True" Height="70"/>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
