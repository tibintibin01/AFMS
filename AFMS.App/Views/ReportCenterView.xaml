<UserControl x:Class="AFMS.App.Views.ReportCenterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Report Center" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Official treasury reports, transaction forms, PDF printing and Excel export." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#E9F5EE" CornerRadius="12" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="FINALIZED DATA BY DEFAULT" Foreground="#257247" FontSize="10" FontWeight="Bold"/></Border></Grid>
        <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="275"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Report catalog" FontSize="17" FontWeight="SemiBold"/><ComboBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,10,0,10"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding ReportDefinitions}" SelectedItem="{Binding SelectedReport}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            </Grid></Border>
            <Grid Grid.Column="1" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="From date" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding FromDate}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="To date" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><DatePicker SelectedDate="{Binding ToDate}"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0"><TextBlock Text="Fiscal year" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><TextBox Text="{Binding FiscalYear}"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0,0,0"><TextBlock Text="Reference number" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><TextBox Text="{Binding ReferenceNumber}" ToolTip="Required for printable transaction forms"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="Form type" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding FormTypes}" SelectedItem="{Binding SelectedFormType}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="Collector" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Collectors}" SelectedItem="{Binding SelectedCollector}"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0"><TextBlock Text="Barangay" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Barangays}" SelectedItem="{Binding SelectedBarangay}"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0,0,0"><TextBlock Text="Accountable-form status" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" IsEditable="False"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Transaction status" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding TransactionStatuses}" SelectedItem="{Binding SelectedTransactionStatus}"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0"><CheckBox Content="Outstanding only" IsChecked="{Binding OutstandingOnly}" Margin="0,0,18,8"/><CheckBox Content="Include drafts explicitly" IsChecked="{Binding IncludeDrafts}" Margin="0,0,0,8"/></StackPanel>
                        <Button Grid.Column="2" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0" VerticalAlignment="Bottom"/><Button Grid.Column="3" Content="Generate preview" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,7,0" VerticalAlignment="Bottom"/><Button Grid.Column="4" Content="PDF preview" Command="{Binding PreviewPdfCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel></Border>
                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PreviewTitle}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding PreviewReference}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="ON-SCREEN PREVIEW" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/></Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Preview}" AutoGenerateColumns="True" Margin="12,0,12,12" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
                </Grid></Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Generating report..." Foreground="#B7791F" FontWeight="SemiBold" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding Message}" Style="{StaticResource NotificationTextStyle}"/><TextBlock Text="{Binding CurrentFile}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="620" HorizontalAlignment="Left"/></StackPanel>
            <WrapPanel Grid.Column="1"><Button Content="Output folder" Command="{Binding SelectFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Save PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Print" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Open file" Command="{Binding OpenFileCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
        </Grid>
    </Grid>
</UserControl>
